set $pan_script ~/.config/sway/scripts/pan_floating.sh
set $nav_script ~/.config/sway/script/navigate_floating.sh

##us / ru
input * {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}

### Variables
set $mod Super
set $term kitty
set $menu qs ipc call launcher toggle
set $filemanager thunar
set $browser firefox

### Output / Gaps / Borders
output * bg #1e1e2e solid_color
gaps inner 8
gaps outer 4
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

### Focus
focus_follows_mouse yes
focus_wrapping yes

### Floating
floating_modifier $mod normal

### SwayFX effects
blur enable
blur_xray enable
blur_passes 2
blur_radius 10
shadows enable
shadow_blur_radius 20
corner_radius 12
animation_duration_ms 260

layer_effects "rofi" blur enable; shadows enable

# QS_AUTOSTART_BEGIN
exec --no-startup-id awww-daemon
exec sq
# QS_AUTOSTART_END
### ====================== KEYBINDS ======================

bindsym $mod+t exec $term
bindsym $mod+d exec $menu
bindsym $mod+e exec $filemanager          # thunar
bindsym $mod+f exec $browser              # firefox

bindsym $mod+z floating toggle
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+l exec hyprlock              # или swaylock
bindsym $mod+a exec qs ipc call wallpapers toggle
bindsym $mod+y exec qs ipc call controlcenter toggle
bindsym $mod+v exec qs ipc call playerdrop toggle
# --- Workspaces ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# --- Focus ---
bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down

# --- Move windows ---
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Down  move down

# --- Resize ---
bindsym $mod+Ctrl+Up    output * scale 1.0
bindsym $mod+Ctrl+Down  output * scale 0.75

# Более крупный resize
bindsym $mod+Alt+Shift+Up    resize grow height 80 px
bindsym $mod+Alt+Shift+Down  resize shrink height 80 px
bindsym $mod+Alt+Shift+Left  resize shrink width 80 px
bindsym $mod+Alt+Shift+Right resize grow width 80 px

# --- Floating pan ---
bindsym $mod+Alt+Left  [floating workspace=__focused__] move right 100 px
bindsym $mod+Alt+Right [floating workspace=__focused__] move left 100 px
bindsym $mod+Alt+Up    [floating workspace=__focused__] move down 100 px
bindsym $mod+Alt+Down  [floating workspace=__focused__] move up 100 px
# --- Navigate floating ---
bindsym $mod+Ctrl+Alt+Left  exec ~/.config/sway/scripts/navigate_floating.sh left
bindsym $mod+Ctrl+Alt+Right exec ~/.config/sway/scripts/navigate_floating.sh right
bindsym $mod+Ctrl+Alt+Up    exec ~/.config/sway/scripts/navigate_floating.sh up
bindsym $mod+Ctrl+Alt+Down  exec ~/.config/sway/scripts/navigate_floating.sh down

# --- Layout / Fullscreen / Scratchpad ---
bindsym $mod+Return exec $term
bindsym $mod+Shift+q exec swaynag -t warning -m 'Выйти из SwayFX?' -B 'Да' 'swaymsg exit'
bindsym $mod+Shift+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+e layout toggle split   # было $mod+e — конфликт с thunar
bindsym $mod+S fullscreen toggle 
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle

bindsym $mod+Minus scratchpad show
bindsym $mod+Shift+Minus move scratchpad

# --- Resize mode ---
mode "resize" {
    bindsym Left  resize shrink width 10 px
    bindsym Right resize grow width 10 px
    bindsym Up    resize grow height 10 px
    bindsym Down  resize shrink height 10 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

include /etc/sway/config.d/*
